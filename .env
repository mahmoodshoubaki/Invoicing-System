# Shared app settings, committed to Git. No secrets in this file:
# machine-specific or secret values go in .env.local, which is not committed.
# NEXT_PUBLIC_ values are fixed when the app is built, so rebuild after changing them.

# Path the app is served under, e.g. /invoicing. Empty means the root of the host name.
NEXT_PUBLIC_BASE_PATH=

NEXT_PUBLIC_APP_NAME="Enterprise Invoicing & Tracking System"
NEXT_PUBLIC_APP_SHORT_NAME="Invoicing System"
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_COMPANY_NAME="Devoteam Middle East"
NEXT_PUBLIC_COMPANY_SHORT_NAME=Devoteam

NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_DEFAULT_CURRENCY=SAR
NEXT_PUBLIC_DEFAULT_VAT_PERCENT=15
